# GEMINI_API_KEY: Required for Gemini AI API calls.
# Server-side only env var. Never exposed in client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FINNHUB_API_KEY: Optional free tier Finnhub API key for earnings calendar.
# If omitted or left blank, next earnings date falls back to Gemini 3.8 Flash with Google Search grounding.
FINNHUB_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
